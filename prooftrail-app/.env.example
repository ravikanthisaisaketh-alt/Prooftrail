# Back end (leave LLM_API_KEY blank for AI-off mode)
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
NYERAS_URL=http://localhost:5173
PROOFTRAIL_URL=http://localhost:5174
NXTMOVE_URL=http://localhost:5175
# Front ends (each site reads these as VITE_* vars; run_all.sh exports them)
VITE_API_URL=http://localhost:8000
VITE_NYERAS_URL=http://localhost:5173
VITE_PROOFTRAIL_URL=http://localhost:5174
VITE_NXTMOVE_URL=http://localhost:5175
# Front ends: leave VITE_DEMO_MODE=0. 1 allows ?learner= with no login (needs back end DEMO_MODE=1).
VITE_DEMO_MODE=0
# Login (demo-grade). AUTH_SECRET signs tokens: make a long random value in .env, never commit it.
AUTH_SECRET=
# DEMO_MODE=1 lets requests without a token use ?learner= style access. Leave 0 normally.
DEMO_MODE=0
